@{
    ViewData["Title"] = "Home";
}

<div class="page-header">
    <h1>Global Logistics Management System (GLMS)</h1>
</div>

<div class="card home-hero-card mb-4">
    <div class="card-body p-4">
        <div class="row align-items-center g-4">
            <div class="col-lg-5">
                <h2 class="home-subtitle">A smarter way to manage logistics operations</h2>
                <p class="home-text">
                    GLMS brings client records, contracts, and service requests together in one
                    structured platform, helping organisations keep information organised and easy to manage.
                </p>
            </div>

            <div class="col-lg-7">
                <img src="~/images/logistics.jpg" class="img-fluid home-image" alt="Logistics Management" />
            </div>
        </div>

        <div class="row g-3 mt-3">
            <div class="col-md-4">
                <div class="home-mini-box">
                    <h5>Client Management</h5>
                    <p class="mb-0">Store and maintain client information in a clear and organised way.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="home-mini-box">
                    <h5>Contract Tracking</h5>
                    <p class="mb-0">Manage service levels, contract dates, and signed agreements.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="home-mini-box">
                    <h5>Service Requests</h5>
                    <p class="mb-0">Record and monitor operational requests through each stage.</p>
                </div>
            </div>
        </div>
    </div>
</div>
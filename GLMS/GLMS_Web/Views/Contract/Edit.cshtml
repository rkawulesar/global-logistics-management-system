@model GLMS_Web.Models.Contract

@{
	ViewData["Title"] = "Edit Contract";
}

<div class="page-header">
	<h1>Edit Contract</h1>
</div>

<div class="row">
	<div class="col-md-6">
		<div class="card">
			<div class="card-header">Contract Information</div>
			<div class="card-body">
				<form asp-action="Edit" enctype="multipart/form-data">
					<div asp-validation-summary="All" class="text-danger mb-3"></div>

					<input type="hidden" asp-for="Id" />
					<input type="hidden" asp-for="FilePath" />

					@if (Context.Session.GetString("UserRole") == "Admin")
					{
						<div class="mb-3">
							<label asp-for="ClientId" class="form-label">Client</label>
							<select asp-for="ClientId" class="form-select" asp-items="ViewBag.ClientId"></select>
							<span asp-validation-for="ClientId" class="text-danger"></span>
						</div>
					}
					else
					{
						<input type="hidden" asp-for="ClientId" />
					}


					<div class="mb-3">
						<label asp-for="StartDate" class="form-label">Start Date</label>
						<input asp-for="StartDate" type="date" class="form-control" id="StartDate" />
						<span asp-validation-for="StartDate" class="text-danger"></span>
					</div>

					<div class="mb-3">
						<label asp-for="EndDate" class="form-label">End Date</label>
						<input asp-for="EndDate" type="date" class="form-control" id="EndDate" />
						<span asp-validation-for="EndDate" class="text-danger"></span>
					</div>

					<div class="mb-3">
						<label asp-for="Status" class="form-label">Status</label>
						<select asp-for="Status" class="form-select">
							<option value="">-- Select Status --</option>
							<option value="Draft">Draft</option>
							<option value="Active">Active</option>
							<option value="Expired">Expired</option>
							<option value="On Hold">On Hold</option>
						</select>
						<span asp-validation-for="Status" class="text-danger"></span>
					</div>

					<div class="mb-3">
						<label asp-for="ServiceLevel" class="form-label">Service Level</label>
						<select asp-for="ServiceLevel" class="form-select">
							<option value="">-- Select Service Level --</option>
							<option value="Standard">Standard</option>
							<option value="Express">Express</option>
							<option value="Premium">Premium</option>
						</select>
						<span asp-validation-for="ServiceLevel" class="text-danger"></span>
					</div>
					@* Code Attribution for opening a pdf in the browser *@ 
                    @* Link: https://stackoverflow.com/questions/11100981/asp-net-mvc-open-pdf-file-in-new-window *@
					<div class="mb-3">
						<label class="form-label">Current Agreement</label>
						<div>
							@if (!string.IsNullOrEmpty(Model.FilePath))
							{
								<a href="@(ViewBag.ApiBaseUrl + Model.FilePath)" target="_blank" class="btn btn-sm btn-secondary">View Current PDF</a>
							}
							else
							{
								<span class="text-muted">No file uploaded</span>
							}
						</div>
					</div>

					<div class="mb-3">
						<label class="form-label">Replace Agreement PDF</label>
						<input type="file" name="pdfFile" class="form-control" accept=".pdf" />
						<span asp-validation-for="FilePath" class="text-danger"></span>
					</div>

					<div class="d-flex gap-2 mt-3">
						<input type="submit" value="Save Changes" class="btn btn-primary" />
						@if (Context.Session.GetString("UserRole") == "Client")
						{
							<a asp-action="MyContracts" class="btn btn-secondary">Back to List</a>
						}
						else
						{
							<a asp-action="Index" class="btn btn-secondary">Back to List</a>
						}
					</div>
				</form>
			</div>
		</div>
	</div>
</div>

@section Scripts {
	@{
		await Html.RenderPartialAsync("_ValidationScriptsPartial");
	}
	@* Prevents selecting an EndDate earlier than StartDate *@
	<script>
		const startDateInput = document.getElementById("StartDate");
		const endDateInput = document.getElementById("EndDate");

		if (startDateInput && endDateInput) {
			endDateInput.min = startDateInput.value;

			startDateInput.addEventListener("change", function () {
				endDateInput.min = startDateInput.value;
					// Clears invalid EndDate if already selected

				if (endDateInput.value && endDateInput.value < startDateInput.value) {
					endDateInput.value = "";
				}
			});
		}
	</script>
}
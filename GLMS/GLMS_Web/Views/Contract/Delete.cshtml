@model GLMS_Web.Models.Contract

@{
	ViewData["Title"] = "Delete Contract";
	var badgeCss = Model.Status switch
	{
		"Active" => "status-active",
		"Expired" => "status-expired",
		"On Hold" => "status-onhold",
		_ => "status-draft"
	};
}
@if (ViewBag.ErrorMessage != null)
{
	<div class="alert" style="background-color: #fff5f5; color: #991b1b; border: 1px solid #dc3545;">
		<strong>⚠</strong> @ViewBag.ErrorMessage
	</div>
}
<div class="page-header">
	<h1>Delete Contract</h1>
</div>

<div class="row">
	<div class="col-md-6">
		<div class="card" style="border-color: #dc3545;">
			<div class="card-header" style="background-color: #fff5f5; color: #991b1b;">
				Are you sure you want to delete this contract?
			</div>
			<div class="card-body">
				<dl class="row mb-0">
					<dt class="col-sm-4">Client</dt>
					<dd class="col-sm-8">@Model.Client?.FirstName @Model.Client?.Surname</dd>

					<dt class="col-sm-4">Start Date</dt>
					<dd class="col-sm-8">@Model.StartDate.ToString("dd/MM/yyyy")</dd>

					<dt class="col-sm-4">End Date</dt>
					<dd class="col-sm-8">@Model.EndDate.ToString("dd/MM/yyyy")</dd>

					<dt class="col-sm-4">Status</dt>
					<dd class="col-sm-8">
						<span class="badge @badgeCss">@Model.Status</span>
					</dd>

					<dt class="col-sm-4">Service Level</dt>
					<dd class="col-sm-8">@Model.ServiceLevel</dd>

					<dt class="col-sm-4">Signed Agreement</dt>
					<dd class="col-sm-8">
						@if (!string.IsNullOrEmpty(Model.FilePath))
						{
							<a href="@Model.FilePath" target="_blank" class="btn btn-sm btn-secondary">View PDF</a>
						}
						else
						{
							<span class="text-muted">No file</span>
						}
					</dd>
				</dl>
			</div>
		</div>

		<form asp-action="Delete" class="mt-3">
			<input type="hidden" asp-for="Id" />
			<div class="d-flex gap-2">
				@if (ViewBag.ErrorMessage != null)
				{
					<button type="button" class="btn btn-danger" disabled>
						Cannot Delete
					</button>
				}
				else
				{
					<input type="submit" value="Yes, Delete" class="btn btn-danger" />
				}

				<a asp-action="Index" class="btn btn-secondary">Cancel</a>
			</div>
		</form>
	</div>
</div>

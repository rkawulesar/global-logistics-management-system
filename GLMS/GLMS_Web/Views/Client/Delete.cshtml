@model GLMS_Web.Models.Client

@{
    ViewData["Title"] = "Delete Client";
}

<div class="page-header">
    <h1>Delete Client</h1>
</div>

@if (ViewBag.ErrorMessage != null)
{
    <div class="alert" style="background-color: #fff5f5; color: #991b1b; border: 1px solid #dc3545;">
        <strong>⚠</strong> @ViewBag.ErrorMessage
    </div>
}

<div class="row">
    <div class="col-md-6">
        <div class="card" style="border-color: #dc3545;">
            <div class="card-header" style="background-color: #fff5f5; color: #991b1b;">
                Are you sure you want to delete this client?
            </div>

            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Name</dt>
                    <dd class="col-sm-8">@Model.FirstName</dd>

                    <dt class="col-sm-4">Surname</dt>
                    <dd class="col-sm-8">@Model.Surname</dd>

                    <dt class="col-sm-4">Email</dt>
                    <dd class="col-sm-8">@Model.Email</dd>

                    <dt class="col-sm-4">Phone Number</dt>
                    <dd class="col-sm-8">@Model.PhoneNumber</dd>

                    <dt class="col-sm-4">Region</dt>
                    <dd class="col-sm-8">@Model.Region</dd>
                </dl>
            </div>
        </div>

        <form asp-action="Delete" class="mt-3">
            <input type="hidden" asp-for="Id" />

            <div class="d-flex gap-2">
                @if (ViewBag.ErrorMessage != null)
                {
                    <button type="button" class="btn btn-danger" disabled>
                        Cannot Delete
                    </button>
                }
                else
                {
                    <input type="submit" value="Yes, Delete" class="btn btn-danger" />
                }

                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>
@model GLMS_Web.Models.ServiceRequest

@{
    ViewData["Title"] = "Delete Service Request";

    var badgeCss = Model.Status switch
    {
        "Pending" => "status-draft",
        "In Progress" => "status-onhold",
        "Completed" => "status-active",
        "Cancelled" => "status-expired",
        _ => "status-draft"
    };
}

<div class="page-header">
    <h1>Delete Service Request</h1>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card" style="border-color: #dc3545;">
            <div class="card-header" style="background-color: #fff5f5; color: #991b1b;">
                Are you sure you want to delete this service request?
            </div>
            <div class="card-body">
                <dl class="row mb-0">
                    <dt class="col-sm-4">Description</dt>
                    <dd class="col-sm-8">@Model.Description</dd>

                    <dt class="col-sm-4">Cost</dt>
                    <dd class="col-sm-8">R @Model.Cost.ToString("N2")</dd>

                    <dt class="col-sm-4">Status</dt>
                    <dd class="col-sm-8">
                        <span class="badge @badgeCss">@Model.Status</span>
                    </dd>

                    <dt class="col-sm-4">Contract</dt>
                    <dd class="col-sm-8">
                        @($"{Model.Contract?.Client?.FirstName} {Model.Contract?.Client?.Surname} - {Model.Contract?.ServiceLevel}")
                    </dd>
                </dl>
            </div>
        </div>

        <form asp-action="Delete" class="mt-3">
            <input type="hidden" asp-for="Id" />

            <div class="d-flex gap-2">
                <input type="submit" value="Yes, Delete" class="btn btn-danger" />
                <a asp-action="Index" class="btn btn-secondary">Cancel</a>
            </div>
        </form>
    </div>
</div>